{
  "name": "@rootcast/relay",
  "version": "1.0.0",
  "description": "Tiny webhook relay between Coolify and the Root bot. Zero runtime dependencies.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
