    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.8.3"
  }
}
